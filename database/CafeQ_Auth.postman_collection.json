		{
			"name": "Provision Cashier (Admin Only)",
			"request": {
				"auth": {
					"type": "bearer",
					"bearer": [
						{
							"key": "token",
							"value": "{{adminToken}}",
							"type": "string"
						}
					]
				},
				"method": "POST",
				"header": [],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"email\": \"cashier1@cafeq.com\",\n    \"password\": \"cashier123\",\n    \"fullName\": \"John Cashier\",\n    \"role\": \"Cashier\",\n    \"phoneNumber\": \"0722334455\",\n    \"stationNumber\": \"STATION-01\"\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{baseUrl}}/auth/provision",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"auth",
						"provision"
					]
				}
			},
			"response": []
		},
		{
			"name": "Get Profile Info (me)",
			"request": {
				"auth": {
					"type": "bearer",
					"bearer": [
						{
							"key": "token",
							"value": "{{studentToken}}",
							"type": "string"
						}
					]
				},
				"method": "GET",
				"header": [],
				"url": {
